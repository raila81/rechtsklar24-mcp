    {
      "name": "get_obligation_dates",
      "title": "Stichtag einer Pflicht im Onlineshop-Recht",
      "description": "Use for \"seit wann gilt\", \"ab wann\", \"wann kommt\", \"Frist\", \"Stichtag\", \"Übergangsfrist\" around German/EU e-commerce obligations: Widerrufsbutton (§ 356a BGB), GPSR, BFSG (Barrierefreiheit), Greenwashing-Verbot/EmpCo, neue Produkthaftungsrichtlinie, Preisangabenverordnung 2022, Erlöschen des Widerrufsrechts. Returns the date from rechtsklar24's source register with the statute, the source URL and the date it was last checked, and says \"gilt seit\" or \"gilt ab\" computed from today. General information only: it does not say whether a particular shop is affected or compliant.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "thema": {
            "type": "string",
            "enum": [
              "widerrufsbutton",
              "gpsr",
              "bfsg",
              "greenwashing_empco",
              "produkthaftung",
              "preisangaben_pangv",
              "widerrufsrecht_erloeschen"
            ],
            "description": "widerrufsbutton = Pflicht zur elektronischen Widerrufsfunktion; gpsr = Produktsicherheitsverordnung; bfsg = Barrierefreiheit; greenwashing_empco = Greenwashing-Verbot; produkthaftung = Umsetzungsfrist der neuen Produkthaftungsrichtlinie; preisangaben_pangv = PAngV 2022 mit 30-Tage-Regel für Streichpreise; widerrufsrecht_erloeschen = Höchstfrist ohne korrekte Belehrung."
          }
        },
        "required": [
          "thema"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "thema": {
            "type": "string"
          },
          "titel": {
            "type": "string"
          },
          "status": {
            "type": "string",
