    {
      "name": "calculate_grundpreis",
      "title": "Grundpreis nach § 5 PAngV berechnen",
      "description": "Use when someone wants the base price (Grundpreis) for a product: \"Grundpreis berechnen\", \"Preis pro Kilo/Liter/Meter/Quadratmeter\", \"12,90 € für 750 g\". Input: total price including VAT, quantity and unit (g, kg, ml, l, mm, cm, m, cm2, m2, m3, stk). Returns the Grundpreis per legal reference unit (1 kg, 1 l, 1 m, 1 m², 1 m³ under § 5 PAngV; 100 g or 100 ml only with loose_goods=true), rounded to two decimals exactly like the calculator on rechtsklar24.de. A per-piece price is computed but flagged as not a Grundpreis (§ 4 PAngV). Arithmetic on the user's numbers only; it does not judge whether a specific offer is lawful.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "price": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Gesamtpreis in Euro inklusive Umsatzsteuer, z. B. 12.9."
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Füllmenge oder Inhalt in der angegebenen Einheit, z. B. 750."
          },
          "unit": {
            "type": "string",
            "enum": [
              "g",
              "kg",
              "ml",
              "l",
              "mm",
              "cm",
              "m",
              "cm2",
              "m2",
              "m3",
              "stk"
            ],
            "description": "Einheit der Menge: g, kg (Gewicht); ml, l (Volumen); mm, cm, m (Länge); cm2, m2 (Fläche); m3 (Raummaß); stk = Stückzahl (kein Grundpreis)."
          },
          "loose_goods": {
            "type": "boolean",
            "description": "true nur bei loser, unverpackter Ware nach Gewicht oder Volumen: dann 100 g bzw. 100 ml als Bezugsgröße (§ 5 Absatz 2 PAngV). Standard false."
          }
        },
        "required": [
          "price",
          "quantity",
          "unit"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ergebnis",
              "kein_grundpreis"
            ],
            "description": "kein_grundpreis = Preis je Stück: § 4 PAngV kennt dafür keinen Grundpreis; der Wert wird trotzdem ausgerechnet."
          },
          "preis": {
            "type": "number"
          },
          "menge": {
            "type": "number"
          },
          "einheit": {
            "type": "string"
          },
          "lose_ware": {
            "type": "boolean"
          },
          "grundpreis": {
            "type": "number",
            "description": "Auf zwei Nachkommastellen gerundet."
          },
          "bezugsgroesse": {
            "type": "string"
          },
          "grundpreis_text": {
            "type": "string"
          },
          "rechnung": {
            "type": "string"
          },
          "hinweis": {
            "type": [
              "string",
              "null"
            ]
          },
          "fakten": {
            "type": "array",
            "items": {
              "type": "object",
